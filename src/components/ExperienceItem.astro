---
import Icon from "./Icon.astro";
import Media from "./Media.astro";
import { formatRange, inline, tr, type Experience } from "../data/cv";
import { publicFileSize } from "../lib/files";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  item: Experience;
  lang: Lang;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);
---

<li class="relative pl-8 sm:pl-10">
  <span
    class:list={[
      "absolute top-2 left-0 size-3.5 -translate-x-1/2 rounded-full ring-4 ring-stone-50 dark:ring-stone-950",
      item.end === null ? "bg-accent-500" : "bg-stone-300 dark:bg-stone-600",
    ]}
    aria-hidden="true"></span>
  <article class="card p-5 sm:p-7" id={item.id}>
    <header class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
      <div>
        <h3 class="text-lg font-semibold sm:text-xl">{item.role[lang]}</h3>
        <p class="text-stone-600 dark:text-stone-400">
          {item.url ? <a href={item.url} target="_blank" rel="noopener" class="hover:underline">{item.org}</a> : item.org}
          {item.place && <span class="text-stone-400"> · {item.place}</span>}
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2 sm:flex-col sm:items-end">
        <time class="text-sm font-medium whitespace-nowrap text-stone-700 tabular-nums dark:text-stone-300">
          {formatRange(item.start, item.end, lang)}
        </time>
        <span class="tag">{t(`kind.${item.kind}`)}</span>
      </div>
    </header>

    <p class="mt-4 text-stone-700 dark:text-stone-300">{item.summary[lang]}</p>

    <ul class="prose-text mt-4 space-y-2.5 text-[0.95rem] leading-relaxed text-stone-700 dark:text-stone-300">
      {
        item.highlights.map((h) => (
          <li class="relative pl-5 before:absolute before:top-[0.6em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent-500">
            <Fragment set:html={inline(h[lang])} />
          </li>
        ))
      }
    </ul>

    {
      item.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tags">
          {item.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )
    }

    {
      item.links.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {item.links.map((l) => {
            const size = publicFileSize(l.url);
            const external = !l.url.startsWith("/");
            return (
              <li>
                <a href={l.url} class="link inline-flex items-center gap-1.5" {...(external ? { target: "_blank", rel: "noopener" } : {})}>
                  <Icon name={l.url.endsWith(".pdf") ? "file" : l.url.includes("github.com") ? "code" : "external"} />
                  {tr(l.label, lang)}
                  {size && <span class="font-normal text-stone-500">· {size}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    <Media items={item.media} lang={lang} />
  </article>
</li>
