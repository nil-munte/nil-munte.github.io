---
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mt-16 py-4 bg-gray-100 border-t border-gray-300">
    <div class="max-w-4xl mx-auto px-4 text-center text-gray-700">
        <div
            class="mt-2 flex flex-col md:flex-row justify-center gap-4 text-sm items-center"
        >
            <a
                href="mailto:nilmunte@gmail.com"
                class="hover:text-blue-600 flex items-center gap-1 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
                📧 {t('footer.email')}: nilmunte@gmail.com
            </a>

            <span class="hidden md:inline">•</span>

            <a
                href="tel:+34628119680"
                class="hover:text-blue-600 flex items-center gap-1 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
                📞 {t('footer.phone')}: +34 628 119 680
            </a>

            <span class="hidden md:inline">•</span>

            <a
                href="https://www.linkedin.com/in/nilmunte"
                target="_blank"
                class="hover:text-gray-800 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
                <Image
                    src="/logos/linkedin.png"
                    alt="LinkedIn"
                    width="20"
                    height="20"
                />
            </a>
            <span class="hidden md:inline">•</span>

            <a
                href="https://github.com/nil-munte"
                target="_blank"
                class="hover:text-gray-800 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
                <Image
                    src="/logos/github-mark.png"
                    alt="GitHub"
                    width="20"
                    height="20"
                />
            </a>

            <span class="hidden md:inline">•</span>

            <a
                href={`/info/${lang}/CV_Nil_Munte_Guerrero_${lang.toUpperCase()}.pdf`}
                download
                class="hover:text-blue-600 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
                📄 {t('footer.cv')}
            </a>
        </div>

        <p class="text-xs text-gray-500 mt-4">
            © {new Date().getFullYear()} Nil Munté — {t('footer.copyright')}
        </p>
    </div>
</footer>
