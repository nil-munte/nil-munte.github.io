---
import { languages, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const routeMapping: Record<string, { en: string; ca: string }> = {
  '/en/': { en: '/en/', ca: '/ca/' },
  '/en/career': { en: '/en/career', ca: '/ca/carrera' },
  '/en/projects': { en: '/en/projects', ca: '/ca/projectes' },
  '/en/about': { en: '/en/about', ca: '/ca/sobre-mi' },
  '/ca/': { en: '/en/', ca: '/ca/' },
  '/ca/carrera': { en: '/en/career', ca: '/ca/carrera' },
  '/ca/projectes': { en: '/en/projects', ca: '/ca/projectes' },
  '/ca/sobre-mi': { en: '/en/about', ca: '/ca/sobre-mi' },
};

function getLanguageSwitchPath(targetLang: Lang): string {
  const sortedPaths = Object.keys(routeMapping).sort((a, b) => b.length - a.length);
  for (const path of sortedPaths) {
    if (currentPath.startsWith(path)) {
      return currentPath.replace(path, routeMapping[path][targetLang]);
    }
  }
  return targetLang === 'en' ? '/en/' : '/ca/';
}
---

<nav class="w-full bg-white shadow fixed top-0 left-0 z-50">
    <div class="max-w-6xl mx-auto flex justify-between items-center p-4">
        <a href={`/${lang}/`} class="text-xl font-bold text-indigo-600">
            {lang === 'en' ? "Nil's Portfolio" : "Portfoli del Nil"}
        </a>
        <div class="flex gap-6 text-gray-700 font-medium items-center">
            <a
                href={`/${lang}/`}
                class={`hover:text-indigo-600 ${currentPath === `/${lang}/` ? "text-indigo-600 font-bold" : ""}`}
            >
                {lang === 'en' ? "Home" : "Inici"}
            </a>
            <a
                href={lang === 'en' ? `/${lang}/career` : `/${lang}/carrera`}
                class={`hover:text-indigo-600 ${currentPath === (lang === 'en' ? `/${lang}/career` : `/${lang}/carrera`) ? "text-indigo-600 font-bold" : ""}`}
            >
                {lang === 'en' ? "Career" : "Carrera"}
            </a>
            <a
                href={lang === 'en' ? `/${lang}/projects` : `/${lang}/projectes`}
                class={`hover:text-indigo-600 ${currentPath === (lang === 'en' ? `/${lang}/projects` : `/${lang}/projectes`) ? "text-indigo-600 font-bold" : ""}`}
            >
                {lang === 'en' ? "Projects" : "Projectes"}
            </a>
            <a
                href={lang === 'en' ? `/${lang}/about` : `/${lang}/sobre-mi`}
                class={`hover:text-indigo-600 ${currentPath === (lang === 'en' ? `/${lang}/about` : `/${lang}/sobre-mi`) ? "text-indigo-600 font-bold" : ""}`}
            >
                {lang === 'en' ? "About Me" : "Sobre Mi"}
            </a>
            <span class="text-gray-300">|</span>
            <div class="flex gap-2">
                <a
                    href={getLanguageSwitchPath('en')}
                    class={`px-2 py-1 rounded text-xs font-medium transition ${
                        lang === 'en' 
                            ? "bg-indigo-600 text-white" 
                            : "bg-gray-100 text-gray-600 hover:bg-gray-200"
                    }`}
                >
                    EN
                </a>
                <a
                    href={getLanguageSwitchPath('ca')}
                    class={`px-2 py-1 rounded text-xs font-medium transition ${
                        lang === 'ca' 
                            ? "bg-indigo-600 text-white" 
                            : "bg-gray-100 text-gray-600 hover:bg-gray-200"
                    }`}
                >
                    CA
                </a>
            </div>
        </div>
    </div>
</nav>
<div class="h-20"></div>
