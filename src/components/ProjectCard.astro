---
import Icon from "./Icon.astro";
import type { CV } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  project: CV["projects"][number];
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="card relative flex flex-col p-6 transition hover:border-accent-300 dark:hover:border-accent-700">
  <h3 class="text-lg font-semibold">{project.title[lang]}</h3>
  <p class="mt-2 flex-1 leading-relaxed text-stone-600 dark:text-stone-400">{project.description[lang]}</p>
  <a href={project.link} target="_blank" rel="noopener" class="link mt-4 inline-flex items-center gap-1.5 text-sm after:absolute after:inset-0">
    {t("common.view_project")}<Icon name="arrow" />
  </a>
</article>
