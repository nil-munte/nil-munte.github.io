---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { CV } from "../data/cv";
import { publicFileSize } from "../lib/files";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  project: CV["projects"][number];
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const main = project.demo ?? project.code;

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/projects/*.{jpg,jpeg,png,webp}", { eager: true });
const shot = project.image ? shots[`../assets/projects/${project.image}`]?.default : undefined;
if (project.image && !shot) throw new Error(`cv.yaml refers to src/assets/projects/${project.image}, which does not exist`);

const links = [
  ...(project.demo ? [{ label: t("projects.demo"), url: project.demo, icon: "external" as const }] : []),
  ...(project.code ? [{ label: t("projects.code"), url: project.code, icon: "github" as const }] : []),
  ...project.links.map((l) => ({
    label: l.label[lang],
    url: l.url,
    icon: l.url.endsWith(".pdf") ? ("file" as const) : ("github" as const),
  })),
];
---

<article class="card relative flex flex-col overflow-hidden transition hover:border-accent-300">
  {
    shot && (
      <Image
        src={shot}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/10] w-full border-b border-stone-200 object-cover object-top"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold">
      {main ? (
        <a href={main} target="_blank" rel="noopener" class="after:absolute after:inset-0">
          {project.title[lang]}
        </a>
      ) : project.title[lang]}
    </h3>
    <p class="mt-2 flex-1 leading-relaxed text-stone-600">{project.description[lang]}</p>
    <ul class="relative z-10 mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        links.map((l) => {
          const local = l.url.startsWith("/");
          const size = publicFileSize(l.url);
          return (
            <li>
              <a href={l.url} class="link inline-flex items-center gap-1.5" {...(local ? { download: "" } : { target: "_blank", rel: "noopener" })}>
                <Icon name={l.icon} />
                {l.label}
                {size && <span class="font-normal text-stone-500">· {size}</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</article>
