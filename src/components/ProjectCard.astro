---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  link: string;
  lang: Lang;
}

const { title, description, link, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="bg-white shadow rounded-xl p-6 hover:shadow-lg transition">
    <h3 class="text-xl font-semibold mb-2 text-indigo-600">{title}</h3>
    <p class="text-gray-700 mb-4">{description}</p>
    <a href={link} target="_blank" class="text-indigo-500 hover:underline"
        >{t('common.view_project')} →</a
    >
</div>
