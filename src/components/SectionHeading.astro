---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  level?: 1 | 2;
}

const { id, eyebrow, title, level = 2 } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---

<div class="mb-8">
  {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
  <Tag id={id} class:list={["font-bold tracking-tight", level === 1 ? "text-4xl sm:text-5xl" : "text-2xl sm:text-3xl"]}>
    {title}
  </Tag>
  <slot />
</div>
