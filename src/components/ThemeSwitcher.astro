---
// Temporary: lets you compare the two design directions while browsing.
// Remove together with the unused theme once one is chosen.
---

<div
  class="fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 whitespace-nowrap rounded-full border border-stone-300 bg-stone-50/95 p-1 font-mono text-xs shadow-lg backdrop-blur"
  role="group"
  aria-label="Maqueta"
>
  <span class="hidden px-2 text-stone-500 sm:inline">Maqueta</span>
  <button type="button" data-set-theme="senyal" class="rounded-full px-3 py-1.5 text-stone-700 aria-pressed:bg-accent-700 aria-pressed:text-[var(--on-accent)]">A · Senyal</button>
  <button type="button" data-set-theme="relleu" class="rounded-full px-3 py-1.5 text-stone-700 aria-pressed:bg-accent-700 aria-pressed:text-[var(--on-accent)]">B · Relleu + senyal</button>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-set-theme]");
  const sync = () =>
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setTheme === document.documentElement.dataset.theme)));
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      document.documentElement.dataset.theme = b.dataset.setTheme;
      try {
        localStorage.setItem("tema", b.dataset.setTheme ?? "");
      } catch {}
      sync();
    }),
  );
  sync();
</script>
