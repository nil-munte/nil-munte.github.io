---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { cv, resume } from "../data/cv";
import { langs, pathFor, useTranslations, type Lang, type PageKey } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** null for pages without a counterpart in the other language (404). */
  page: PageKey | null;
  title?: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const siteTitle = cv.person.site_title[lang];
// Search results show the <title>: it always carries the full name.
const fullTitle = title ? `${title} · ${cv.person.name}` : t("meta.home_title");
const canonical = page ? new URL(pathFor(page, lang), site).href : undefined;
const ogImage = new URL(`/og-${lang}.png`, site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.person.name,
  url: site.href,
  email: `mailto:${cv.person.email}`,
  jobTitle: resume.person.headline[lang],
  description: t("meta.home"),
  worksFor: resume.experience
    .filter((e) => e.end === null)
    .map((e) => ({ "@type": "Organization", name: e.org })),
  alumniOf: [...new Set(resume.education.map((e) => e.org.split(",")[0]))].map((name) => ({
    "@type": "CollegeOrUniversity",
    name,
  })),
  sameAs: [...cv.person.links.map((l) => l.url), ...cv.person.same_as],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={cv.person.name} />
    <!-- Google Search Console ownership (same account as the physics site). -->
    <meta name="google-site-verification" content="O0s7mEiCGPQjfAXXE9GVEZe_Zo362YuunVUuxaPKBVE" />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      page &&
        langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(page, l), site).href} />)
    }
    {page && <link rel="alternate" hreflang="x-default" href={new URL(pathFor(page, "en"), site).href} />}

    <meta property="og:type" content={page === "home" ? "profile" : "website"} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "ca" ? "ca_ES" : "en_GB"} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >{t("a11y.skip")}</a
    >
    <Header lang={lang} page={page} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
