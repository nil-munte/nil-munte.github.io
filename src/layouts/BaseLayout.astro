---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ui, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://nil-munte.github.io';

const translations = ui[lang];
const pageTitle = translations['meta.title'] || translations['nav.portfolio_title'];

function getAlternatePath(targetLang: Lang): string {
  return currentPath.replace(`/${lang}/`, `/${targetLang}/`);
}
---

<html lang={lang} class="scroll-smooth h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <link rel="alternate" hreflang="en" href={`${site}/en/`} />
        <link rel="alternate" hreflang="ca" href={`${site}/ca/`} />
        <link rel="alternate" hreflang="x-default" href={`${site}/en/`} />
    </head>
    <body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
        <Navbar lang={lang} currentPath={currentPath} />
        <main class="flex-grow px-6 md:px-16 lg:px-32 py-8">
            <slot />
        </main>
        <Footer lang={lang} />
    </body>
</html>
