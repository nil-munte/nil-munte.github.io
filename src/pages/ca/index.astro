---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "../../i18n/utils";

const lang = 'ca' as Lang;
const t = useTranslations(lang) as (key: string) => string;
---

<BaseLayout lang={lang}>
  <section
    class="flex flex-col items-center justify-center text-center py-28 px-6
         bg-gradient-to-b from-gray-100 via-white to-gray-100"
  >
    <h1
      class="text-5xl md:text-7xl font-extrabold text-gray-900 tracking-tight drop-shadow-sm"
    >
      Nil Munté Guerrero
    </h1>

    <p class="text-xl md:text-2xl text-gray-700 mt-6 font-semibold">
      {t('home.presentation_subtitle')}
    </p>

    <p class="text-lg md:text-xl text-gray-600 mt-1">
      {t('home.presentation_subtitle2')}
    </p>

    <div class="mt-4 flex flex-wrap justify-center gap-5">
      <a
        href="https://www.linkedin.com/in/nilmunte"
        target="_blank"
        class="hover:text-blue-600 hover:-translate-y-0.5 active:translate-y-0 transition-all"
      >
        <Image
          src="/logos/linkedin.png"
          alt="LinkedIn"
          width="25"
          height="25"
          loading="eager"
        />
      </a>
      <a
        href="https://github.com/nil-munte"
        target="_blank"
        class="hover:text-gray-800 hover:-translate-y-0.5 active:translate-y-0 transition-all"
      >
        <Image
          src="/logos/github-mark.png"
          alt="GitHub"
          width="25"
          height="25"
          loading="eager"
        />
      </a>
    </div>

    <p class="mt-10 max-w-3xl text-gray-700 leading-relaxed text-lg md:text-xl">
      {t('home.presentation_text')}
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={`/info/${lang}/CV_Nil_Munte_Guerrero_${lang.toUpperCase()}.pdf`}
        download
        class="px-6 py-3 bg-green-600 text-white font-semibold rounded-xl shadow-md
             hover:bg-green-700 hover:-translate-y-0.5 active:translate-y-0 transition-all"
      >
        {t('common.download_cv')}
      </a>
    </div>

    <div
      class="mt-14 w-56 h-1.5 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500
           rounded-full animate-pulse opacity-80"
    >
    </div>
  </section>
</BaseLayout>
