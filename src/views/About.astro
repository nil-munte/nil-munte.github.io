---
import PageHeader from "../components/PageHeader.astro";
import { cv } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageHeader title={t("title.about")} />
<div class="container-page">

  <div class="card p-6 sm:p-8">
    <div class="max-w-2xl space-y-4 text-lg leading-relaxed text-stone-700">
      {cv.about.map((p) => <p>{p[lang]}</p>)}
    </div>

    {
      cv.strava.length > 0 && (
        <>
          {/* min-h reserves the embed's height so the page doesn't jump when it loads. */}
          <div class="strava mt-8 grid gap-4 md:grid-cols-3" data-title={t("a11y.strava")}>
            {cv.strava.map((id) => (
              <div class="min-h-[458px]">
                <div class="strava-embed-placeholder" data-embed-type="activity" data-embed-id={id} data-style="standard" data-from-embed="false" />
              </div>
            ))}
          </div>
          <script is:inline defer src="https://strava-embeds.com/embed.js" />
          <script>
            // Strava's script adds untitled iframes; name them for screen readers.
            const box = document.querySelector<HTMLElement>(".strava");
            if (box) {
              const name = () => box.querySelectorAll("iframe:not([title])").forEach((f) => f.setAttribute("title", box.dataset.title ?? "Strava"));
              new MutationObserver(name).observe(box, { childList: true, subtree: true });
              name();
            }
          </script>
        </>
      )
    }
  </div>
</div>
