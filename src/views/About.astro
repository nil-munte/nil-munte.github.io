---
import PageHeader from "../components/PageHeader.astro";
import { cv } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageHeader title={t("title.about")} />
<div class="container-page">

  <div class="card p-6 sm:p-8">
    <div class="max-w-2xl space-y-4 text-lg leading-relaxed text-stone-700">
      {cv.about.map((p) => <p>{p[lang]}</p>)}
    </div>

    {
      cv.strava.length > 0 && (
        <>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            {cv.strava.map((id) => (
              <div class="strava-embed-placeholder" data-embed-type="activity" data-embed-id={id} data-style="standard" data-from-embed="false" />
            ))}
          </div>
          <script is:inline defer src="https://strava-embeds.com/embed.js" />
        </>
      )
    }
  </div>
</div>
