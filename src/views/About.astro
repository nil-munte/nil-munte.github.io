---
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import { cv, inline } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageHeader title={t("title.about")} />
<div class="container-page">
  <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-stone-700">
    {cv.about.map((p) => <p set:html={inline(p[lang])} />)}
  </div>

  <section aria-labelledby="contact" class="card mt-14 max-w-2xl p-6 sm:p-8">
    <h2 id="contact" class="text-2xl font-bold tracking-tight">{t("about.contact")}</h2>
    <p class="mt-3 text-stone-600">{t("about.contact_text")}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${cv.person.email}`} class="btn-primary"><Icon name="mail" />{cv.person.email}</a>
      {
        cv.person.links
          .filter((l) => l.id === "linkedin")
          .map((l) => (
            <a href={l.url} target="_blank" rel="me noopener" class="btn-ghost">
              <Icon name={l.id} />
              {l.label}
            </a>
          ))
      }
    </div>
  </section>
</div>
