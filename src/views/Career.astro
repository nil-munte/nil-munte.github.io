---
import LinkButtons from "../components/LinkButtons.astro";
import Media from "../components/Media.astro";
import { cv, inline } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="container-page pt-12 sm:pt-16">
  <h1 class="page-title">{t("title.career")}</h1>
  <div class="signal-rule mt-6 mb-12" aria-hidden="true"></div>

  <ol class="timeline space-y-8">
    {
      cv.career.map((item) => (
        <li class="timeline-item">
          <article class="card p-5 sm:p-8" id={item.id}>
            <h2 class="text-xl font-bold sm:text-2xl">{item.title[lang]}</h2>
            <p class="org mt-1 text-stone-500 dark:text-stone-400">{item.org[lang]}</p>
            <p class="mt-5 leading-relaxed text-stone-700 dark:text-stone-300">{item.intro[lang]}</p>

            {item.list.length > 0 && (
              <ul class="prose-text mt-5 space-y-3 leading-relaxed text-stone-700 dark:text-stone-300">
                {item.list.map((entry) => (
                  <li class="bullet">
                    <Fragment set:html={inline(entry[lang])} />
                  </li>
                ))}
              </ul>
            )}

            {item.sections.map((section) => (
              <section class="mt-8">
                <h3 class="text-lg font-semibold">{section.title[lang]}</h3>
                {section.paragraphs.map((p) => (
                  <p class="mt-3 leading-relaxed text-stone-700 dark:text-stone-300">{p[lang]}</p>
                ))}
                <LinkButtons links={section.links} lang={lang} />
                <Media items={section.media} lang={lang} />
              </section>
            ))}

            <LinkButtons links={item.links} lang={lang} />
            <Media items={item.media} lang={lang} />
          </article>
        </li>
      ))
    }
  </ol>
</div>
