---
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { cv, formatRange, resume } from "../data/cv";
import { cvPdf, pathFor, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// What I do now (the CV's current jobs) and the featured projects: they show
// there is more to the site than the hero, also on a phone.
const current = resume.experience.filter((job) => job.end === null);
const featured = cv.projects.filter((p) => p.featured).slice(0, 3);
---

<section class="hero-grid">
  <div class="hero-text py-20 sm:py-32">
    <p class="eyebrow">{resume.person.headline[lang]}</p>
    <h1 class="mt-3 text-5xl font-bold tracking-tight sm:text-7xl">{cv.person.name}</h1>
    <div class="signal-rule mt-6" aria-hidden="true"></div>
    <p class="mt-8 text-lg leading-relaxed text-stone-700">{resume.person.summary[lang]}</p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href={cvPdf(lang)} download class="btn-primary"><Icon name="download" />{t("common.download_cv")}</a>
      {
        cv.person.links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="me noopener"
            class="grid size-11 place-items-center rounded-lg text-stone-500 hover:bg-stone-100 hover:text-stone-900"
          >
            <Icon name={l.id} class="size-5" />
            <span class="sr-only">{l.label}</span>
          </a>
        ))
      }
    </div>
  </div>
  <!-- Real contours of the Mola de Colldejou, with the radar on the summit. -->
  <div class="hero-art" aria-hidden="true">
    <div class="terrain"></div>
    <div class="radar"></div>
    <span class="summit"></span>
  </div>
</section>

<section aria-labelledby="now" class="container-page mt-4">
  <h2 id="now" class="eyebrow mb-5 text-sm">{t("home.now")}</h2>
  <ul class="grid gap-4 sm:grid-cols-3">
    {
      current.map((job) => (
        <li>
          <a href={pathFor("career", lang, `#${job.id}`)} class="card block h-full p-5 transition hover:border-accent-300">
            <p class="font-semibold text-stone-900">{job.role[lang]}</p>
            <p class="text-stone-600">{job.org}</p>
            <p class="mt-2 font-mono text-xs text-stone-500">{formatRange(job.start, job.end, lang)}</p>
          </a>
        </li>
      ))
    }
  </ul>
  <a href={pathFor("career", lang)} class="link mt-5 inline-flex items-center gap-1.5 text-sm">
    {t("home.all_career")}<Icon name="arrow" />
  </a>
</section>

<section aria-labelledby="featured" class="container-page mt-16">
  <h2 id="featured" class="eyebrow mb-5 text-sm">{t("home.featured")}</h2>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((p) => <ProjectCard project={p} lang={lang} />)}
  </div>
  <a href={pathFor("projects", lang)} class="link mt-5 inline-flex items-center gap-1.5 text-sm">
    {t("home.all_projects")}<Icon name="arrow" />
  </a>
</section>
