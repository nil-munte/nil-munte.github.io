---
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { cv } from "../data/cv";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = (["research", "web", "teaching"] as const).map((category) => ({
  category,
  title: t(`projects.${category}`),
  items: cv.projects.filter((p) => p.category === category),
}));
---

<PageHeader title={t("title.projects")} />
<div class="container-page space-y-14">
  {
    groups.map((g) => (
      <section aria-labelledby={`group-${g.category}`}>
        <h2 id={`group-${g.category}`} class="eyebrow mb-5 text-sm">
          {g.title}
        </h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((p) => (
            <ProjectCard project={p} lang={lang} />
          ))}
        </div>
      </section>
    ))
  }
</div>
